<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/calculator_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/hoursInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hours_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/hourlyRateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hourly_rate_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/taxRateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tax_rate_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/calculateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calculate" />

        <TextView
            android:id="@+id/payText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/pay_initial"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/overtimePayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overtime_initial"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/totalPayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/total_initial"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/taxText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tax_initial"
            android:textSize="18sp" />

        <Button
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about" />

    </LinearLayout>
</ScrollView>